@model Miembro
@{
    ViewData["Title"] = "Editar rider";
}

<section class="py-5 fondo-carbon text-white seccion-pagina">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <p class="etiqueta">Miembros</p>
                <h2>Editar rider</h2>
                <p class="lead">Actualiza los datos de @Model.Nombre. La cuota se recalcula según el plan y el cilindraje.</p>

                <div class="alert alerta-club" id="info-cuota">
                    Presiona "Calcular cuota" para ver la nueva cuota.
                </div>
            </div>

            <div class="col-lg-8">
                <form asp-action="Editar" asp-route-id="@Model.Id" method="post" class="formulario" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <partial name="_FormularioMiembro" model="Model" />

                    <div class="mt-3">
                        <button type="button" class="btn btn-dorado" id="calcular-cuota">Calcular cuota</button>
                        <button type="submit" class="btn btn-vino">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-borde-claro">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
