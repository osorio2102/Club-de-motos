@model List<Miembro>
@{
    ViewData["Title"] = "Miembros";
    var tiposMoto = (List<string>)ViewBag.TiposMoto;
    string filtro = ViewBag.Filtro;
}

<section class="py-5 fondo-pergamino seccion-pagina">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <p class="etiqueta">Miembros</p>
                <h2>Riders inscritos</h2>
            </div>

            <!-- Filtro: se envia por GET al mismo controlador -->
            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-end">
                <div>
                    <label for="tipoMoto" class="form-label mb-1">Filtrar por tipo de moto</label>
                    <select id="tipoMoto" name="tipoMoto" class="form-select">
                        <option value="Todas">Todas</option>
                        @foreach (var tipo in tiposMoto)
                        {
                            <option value="@tipo" selected="@(tipo == filtro)">@tipo</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-vino">Filtrar</button>
            </form>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-secondary">No hay riders con ese tipo de moto.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="encabezado-tabla">
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Moto</th>
                            <th>Cilindraje</th>
                            <th>Plan</th>
                            <th>Cuota</th>
                            <th>Fecha de ingreso</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td>@m.Id</td>
                                <td>@m.Nombre</td>
                                <td>@m.TipoMoto</td>
                                <td>@m.Cilindraje cc</td>
                                <td>@m.Plan</td>
                                <td>$@m.CuotaMensual.ToString("N0")</td>
                                <td>@m.FechaIngreso?.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p><strong>Total de riders:</strong> @Model.Count &nbsp;|&nbsp; <strong>Total cuotas al mes:</strong> $@(((decimal)ViewBag.TotalCuotas).ToString("N0"))</p>
        }

        <a asp-action="Inscripcion" class="btn btn-dorado">+ Inscribir nuevo rider</a>
    </div>
</section>
