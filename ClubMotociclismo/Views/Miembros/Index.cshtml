@model List<Miembro>
@{
    ViewData["Title"] = "Miembros";
    var tiposMoto = (List<string>)ViewBag.TiposMoto;
    var planes = (List<Plan>)ViewBag.Planes;
    string filtro = ViewBag.Filtro;
    int? planFiltro = ViewBag.PlanFiltro;
}

<section class="py-5 fondo-pergamino seccion-pagina">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <p class="etiqueta">Miembros</p>
                <h2>Riders inscritos</h2>
            </div>

            <!-- Filtros: se envían por GET al mismo controlador -->
            <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                    <label for="tipoMoto" class="form-label mb-1">Tipo de moto</label>
                    <select id="tipoMoto" name="tipoMoto" class="form-select">
                        <option value="Todas">Todas</option>
                        @foreach (var tipo in tiposMoto)
                        {
                            <option value="@tipo" selected="@(tipo == filtro)">@tipo</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="planId" class="form-label mb-1">Plan</label>
                    <select id="planId" name="planId" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var plan in planes)
                        {
                            <option value="@plan.Id" selected="@(plan.Id == planFiltro)">@plan.Nombre</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-vino">Filtrar</button>
            </form>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="alert alert-secondary">No hay riders con esos filtros.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="encabezado-tabla">
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Moto</th>
                            <th>Cilindraje</th>
                            <th>Plan</th>
                            <th>Cuota</th>
                            <th>Fecha de ingreso</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td>@m.Id</td>
                                <td>@m.Nombre</td>
                                <td>@m.TipoMoto</td>
                                <td>@m.Cilindraje cc</td>
                                <!-- Nombre del plan relacionado (propiedad de navegación) -->
                                <td>@m.Plan?.Nombre</td>
                                <td>$@m.CuotaMensual.ToString("N0")</td>
                                <td>@m.FechaIngreso?.ToString("dd/MM/yyyy")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Detalles" asp-route-id="@m.Id" class="btn btn-sm btn-borde-oscuro">Ver</a>
                                    <a asp-action="Editar" asp-route-id="@m.Id" class="btn btn-sm btn-dorado">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@m.Id" class="btn btn-sm btn-vino">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p><strong>Total de riders:</strong> @Model.Count &nbsp;|&nbsp; <strong>Total cuotas al mes:</strong> $@(((decimal)ViewBag.TotalCuotas).ToString("N0"))</p>
        }

        <a asp-action="Inscripcion" class="btn btn-dorado">+ Inscribir nuevo rider</a>
        <a asp-controller="Planes" asp-action="Index" class="btn btn-borde-oscuro">Administrar planes</a>
    </div>
</section>
