@model Plan
@{
    ViewData["Title"] = "Plan " + Model.Nombre;
}

<section class="py-5 fondo-pergamino seccion-pagina">
    <div class="container">
        <p class="etiqueta">Plan de membresía</p>
        <h2>@Model.Nombre — $@Model.CuotaMensual.ToString("N0") al mes</h2>
        <p class="lead">@Model.Descripcion</p>

        <h4 class="mt-4">Riders con este plan (@Model.Miembros.Count)</h4>

        @if (Model.Miembros.Count == 0)
        {
            <div class="alert alert-secondary">Ningún rider tiene este plan todavía.</div>
        }
        else
        {
            <!-- Registros de la entidad relacionada (lado "muchos") -->
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="encabezado-tabla">
                        <tr>
                            <th>Nombre</th>
                            <th>Moto</th>
                            <th>Cilindraje</th>
                            <th>Cuota</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Miembros)
                        {
                            <tr>
                                <td>@m.Nombre</td>
                                <td>@m.TipoMoto</td>
                                <td>@m.Cilindraje cc</td>
                                <td>$@m.CuotaMensual.ToString("N0")</td>
                                <td class="text-end">
                                    <a asp-controller="Miembros" asp-action="Detalles" asp-route-id="@m.Id" class="btn btn-sm btn-borde-oscuro">Ver</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-dorado">Editar plan</a>
        <a asp-action="Index" class="btn btn-borde-oscuro">Volver a planes</a>
    </div>
</section>
