@model List<Plan>
@{
    ViewData["Title"] = "Planes";
}

<section class="py-5 fondo-pergamino seccion-pagina">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <p class="etiqueta">Membresías</p>
                <h2>Planes del club</h2>
            </div>
            <a asp-action="Crear" class="btn btn-dorado">+ Nuevo plan</a>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="alert alert-secondary">Todavía no hay planes registrados.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="encabezado-tabla">
                        <tr>
                            <th>#</th>
                            <th>Plan</th>
                            <th>Cuota mensual</th>
                            <th>Descripción</th>
                            <th>Miembros</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.Id</td>
                                <td><strong>@p.Nombre</strong></td>
                                <td>$@p.CuotaMensual.ToString("N0")</td>
                                <td>@p.Descripcion</td>
                                <!-- Cantidad de registros relacionados (colección de navegación) -->
                                <td>@p.Miembros.Count</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Detalles" asp-route-id="@p.Id" class="btn btn-sm btn-borde-oscuro">Ver</a>
                                    <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-dorado">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@p.Id" class="btn btn-sm btn-vino">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <a asp-controller="Miembros" asp-action="Index" class="btn btn-borde-oscuro">Ver riders inscritos</a>
    </div>
</section>
