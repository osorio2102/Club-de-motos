@model Plan
@{
    ViewData["Title"] = "Nuevo plan";
}

<section class="py-5 fondo-carbon text-white seccion-pagina">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <p class="etiqueta">Membresías</p>
                <h2>Nuevo plan</h2>
                <p class="lead">El plan aparecerá en la lista desplegable del formulario de inscripción.</p>
            </div>
            <div class="col-lg-8">
                <form asp-action="Crear" method="post" class="formulario" novalidate>
                    <partial name="_FormularioPlan" model="Model" />
                    <div class="mt-3">
                        <button type="submit" class="btn btn-vino">Guardar plan</button>
                        <a asp-action="Index" class="btn btn-borde-claro">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
